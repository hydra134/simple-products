{
  "name": "backend-admin-panel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --include 'src/**/*' src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run --config ../../vitest.config.js apps/backend-admin-panel",
    "test:integration": "vitest run --config ../../vitest.config.js --mode integration apps/backend-admin-panel",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fastify/autoload": "6.5.1",
    "@fastify/postgres": "6.1.1",
    "@fastify/sensible": "6.0.7",
    "dotenv": "18.0.9",
    "drizzle-orm": "1.0.0-rc.5",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "tsx": "4.23.15",
    "typescript": "catalog:"
  }
}
